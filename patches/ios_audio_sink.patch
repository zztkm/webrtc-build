+#import <Foundation/Foundation.h>
+#import "sdk/objc/base/RTCMacros.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+@class RTC_OBJC_TYPE(RTCAudioTrack);
+
+/**
+ * RTCAudioSinkプロトコル
+ * 音声データを受信するためのインターフェース
+ */
+RTC_OBJC_EXPORT
+@protocol RTC_OBJC_TYPE(RTCAudioSink) <NSObject>
+
+/**
+ * 音声データ受信コールバック
+ * @param audioTrack 音声トラック
+ * @param audioData PCM音声データ
+ * @param bitsPerSample ビット深度（通常16）
+ * @param sampleRate サンプルレート（Hz）
+ * @param numberOfChannels チャンネル数
+ * @param numberOfFrames フレーム数
+ */
+- (void)audioTrack:(RTC_OBJC_TYPE(RTCAudioTrack) *)audioTrack
+    didReceiveData:(NSData *)audioData
+    bitsPerSample:(NSInteger)bitsPerSample
+        sampleRate:(NSInteger)sampleRate
+  numberOfChannels:(NSInteger)numberOfChannels
+    numberOfFrames:(NSInteger)numberOfFrames;
+
+@optional
+/**
+ * 希望するチャンネル数を返す
+ * @return チャンネル数（-1の場合は指定なし）
+ */
+- (NSInteger)preferredNumberOfChannels;
+
+@end
+
+NS_ASSUME_NONNULL_END
+
