+- (void)addAudioSink:(id<RTC_OBJC_TYPE(RTCAudioSink)>)sink {
+  if (kRTCAudioSinkDebugLogging) {
+    NSString *sinkClassName = NSStringFromClass([sink class]);
+    NSString *threadName = [NSThread isMainThread] ? @"Main" : 
+                          [NSThread currentThread].name ?: @"Background";
+    pthread_t currentThread = pthread_self();
+    
+    NSLog(@"[RTCAudioTrack DEBUG] ======== ADD AUDIO SINK START ========");
+    NSLog(@"[RTCAudioTrack DEBUG] Called from thread: %@ (pthread: %p)", 
+          threadName, (void*)currentThread);
+    NSLog(@"[RTCAudioTrack DEBUG] Sink class: %@", sinkClassName);
+    NSLog(@"[RTCAudioTrack DEBUG] Sink address: %p", sink);
+    NSLog(@"[RTCAudioTrack DEBUG] Track ID: %@", 
+          [NSString stringWithUTF8String:self.nativeTrack->id().c_str()]);
+    
+    RTC_LOG(LS_VERBOSE) << "[addAudioSink] Called from Swift/ObjC"
+                        << " - Sink class: " << [sinkClassName UTF8String]
+                        << " - Thread: " << [threadName UTF8String];
+  }
+  
+  if (!_workerThread->IsCurrent()) {
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioTrack DEBUG] Not on worker thread, dispatching...");
+      NSLog(@"[RTCAudioTrack DEBUG] Worker thread: %p, Current: %p", 
+            _workerThread, rtc::Thread::Current());
+      RTC_LOG(LS_VERBOSE) << "[addAudioSink] Dispatching to worker thread";
+    }
+    
+    _workerThread->BlockingCall(
+        [sink, self] { 
+          if (kRTCAudioSinkDebugLogging) {
+            NSLog(@"[RTCAudioTrack DEBUG] Now on worker thread");
+          }
+          [self addAudioSink:sink]; 
+        });
+    return;
+  }
+
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] On worker thread, checking for duplicates...");
+    NSLog(@"[RTCAudioTrack DEBUG] Current adapters count: %lu", 
+          (unsigned long)_adapters.count);
+  }
+
+  // Make sure we don't have this sink yet.
+  for (RTCAudioSinkAdapter *adapter in _adapters) {
+    if (adapter.audioSink == sink) {
+      if (kRTCAudioSinkDebugLogging) {
+        NSLog(@"[RTCAudioTrack DEBUG] Sink already attached, skipping");
+      }
+      RTC_LOG(LS_INFO) << "|sink| is already attached to this track";
+      return;
+    }
+  }
+  
+  // Create a wrapper that provides a native pointer for us.
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] Creating RTCAudioSinkAdapter...");
+  }
+  
+  RTCAudioSinkAdapter *adapter =
+      [[RTCAudioSinkAdapter alloc] initWithAudioSink:sink];
+  
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] Adapter created: %p", adapter);
+    NSLog(@"[RTCAudioTrack DEBUG] Native sink pointer: %p", 
+          adapter.nativeAudioSink);
+  }
+  
+  [_adapters addObject:adapter];
+  
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] Adding native sink to audio track...");
+    RTC_LOG(LS_VERBOSE) << "[addAudioSink] Calling native AddSink"
+                        << " - Native sink: " << adapter.nativeAudioSink;
+  }
+  
+  // === DETAILED PRE-ADDSINK VALIDATION ===
+  webrtc::scoped_refptr<webrtc::AudioTrackInterface> nativeTrack = self.nativeAudioTrack;
+  webrtc::AudioTrackSinkInterface* nativeSink = adapter.nativeAudioSink;
+  
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] === PRE-ADDSINK VALIDATION ===");
+    NSLog(@"[RTCAudioTrack DEBUG] Native track pointer: %p", nativeTrack.get());
+    NSLog(@"[RTCAudioTrack DEBUG] Native sink pointer: %p", nativeSink);
+    
+    // Skip detailed checks - they cause crashes
+    NSLog(@"[RTCAudioTrack DEBUG] Skipping detailed validation to avoid crash");
+    
+    if (!nativeSink) {
+      NSLog(@"[RTCAudioTrack DEBUG] ❌ CRITICAL: nativeAudioSink is NULL!");
+    }
+    
+    NSLog(@"[RTCAudioTrack DEBUG] === DIRECT ADDSINK CALL ===");
+    RTC_LOG(LS_VERBOSE) << "[addAudioSink] Skipping detailed validation, calling AddSink directly";
+  }
+  
+  if (!nativeTrack.get()) {
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioTrack DEBUG] ❌ Cannot call AddSink: nativeAudioTrack is NULL");
+    }
+    return;
+  }
+  
+  if (!nativeSink) {
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioTrack DEBUG] ❌ Cannot call AddSink: nativeAudioSink is NULL");
+    }
+    return;
+  }
+  
+  // Direct AddSink call with exception handling
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] 🔄 DIRECT AddSink call starting...");
+  }
+  
+  @try {
+    nativeTrack->AddSink(nativeSink);
+    
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioTrack DEBUG] ✅ AddSink call RETURNED successfully!");
+      RTC_LOG(LS_VERBOSE) << "[addAudioSink] AddSink call returned successfully";
+    }
+  } @catch (NSException* exception) {
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioTrack DEBUG] ❌ Exception caught: %@", exception);
+      RTC_LOG(LS_ERROR) << "[addAudioSink] Exception: " 
+                        << [exception.description UTF8String];
+    }
+    return;
+  }
+  
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] ✅ Audio sink successfully added!");
+    NSLog(@"[RTCAudioTrack DEBUG] Total adapters: %lu", 
+          (unsigned long)_adapters.count);
+    NSLog(@"[RTCAudioTrack DEBUG] ======== ADD AUDIO SINK END ========");
+    
+    RTC_LOG(LS_VERBOSE) << "[addAudioSink] Successfully added sink"
+                        << " - Total adapters: " << _adapters.count;
+  }
+}
+
+- (void)removeAudioSink:(id<RTC_OBJC_TYPE(RTCAudioSink)>)sink {
+  if (kRTCAudioSinkDebugLogging) {
+    NSString *sinkClassName = NSStringFromClass([sink class]);
+    NSLog(@"[RTCAudioTrack DEBUG] ======== REMOVE AUDIO SINK START ========");
+    NSLog(@"[RTCAudioTrack DEBUG] Removing sink class: %@", sinkClassName);
+    NSLog(@"[RTCAudioTrack DEBUG] Sink address: %p", sink);
+    RTC_LOG(LS_VERBOSE) << "[removeAudioSink] Called - Sink class: " 
+                        << [sinkClassName UTF8String];
+  }
+  
+  if (!_workerThread->IsCurrent()) {
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioTrack DEBUG] Dispatching to worker thread for removal");
+    }
+    _workerThread->BlockingCall(
+        [sink, self] { [self removeAudioSink:sink]; });
+    return;
+  }
+  
+  __block NSUInteger indexToRemove = NSNotFound;
+  [_adapters enumerateObjectsUsingBlock:^(
+                 RTCAudioSinkAdapter *adapter, NSUInteger idx, BOOL *stop) {
+    if (adapter.audioSink == sink) {
+      indexToRemove = idx;
+      *stop = YES;
+    }
+  }];
+  
+  if (indexToRemove == NSNotFound) {
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioTrack DEBUG] ⚠️ Sink not found in adapters");
+    }
+    RTC_LOG(LS_INFO) << "removeAudioSink called with a sink that has not "
+                        "been previously added";
+    return;
+  }
+  
+  RTCAudioSinkAdapter *adapterToRemove =
+      [_adapters objectAtIndex:indexToRemove];
+  
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] Removing native sink from audio track...");
+    NSLog(@"[RTCAudioTrack DEBUG] Adapter to remove: %p", adapterToRemove);
+  }
+  
+  self.nativeAudioTrack->RemoveSink(adapterToRemove.nativeAudioSink);
+  [_adapters removeObjectAtIndex:indexToRemove];
+  
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioTrack DEBUG] ✅ Audio sink successfully removed!");
+    NSLog(@"[RTCAudioTrack DEBUG] Remaining adapters: %lu", 
+          (unsigned long)_adapters.count);
+    NSLog(@"[RTCAudioTrack DEBUG] ======== REMOVE AUDIO SINK END ========");
+    RTC_LOG(LS_VERBOSE) << "[removeAudioSink] Successfully removed sink"
+                        << " - Remaining adapters: " << _adapters.count;
+  }
+}
