+/*
+ *  Copyright 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import <Foundation/Foundation.h>
+
+#import "sdk/objc/base/RTCMacros.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+/** 
+ * RTCAudioSink is a protocol for receiving audio data from an AudioTrack.
+ * The audio data is provided in PCM format.
+ */
+RTC_OBJC_EXPORT
+@protocol RTC_OBJC_TYPE(RTCAudioSink) <NSObject>
+
+/**
+ * Called when audio data is available.
+ *
+ * @param audioData Raw audio data in PCM format
+ * @param bitsPerSample Number of bits per sample (typically 16)
+ * @param sampleRate Sample rate in Hz (e.g., 44100, 48000)
+ * @param numberOfChannels Number of audio channels (1 for mono, 2 for stereo)
+ * @param numberOfFrames Number of audio frames in this buffer
+ * @param absoluteCaptureTimestampMs Optional timestamp when this audio frame was originally captured
+ */
+- (void)onAudioDataWithBuffer:(NSData *)audioData
+                bitsPerSample:(NSInteger)bitsPerSample
+                   sampleRate:(NSInteger)sampleRate
+            numberOfChannels:(NSUInteger)numberOfChannels
+             numberOfFrames:(NSUInteger)numberOfFrames
+    absoluteCaptureTimestamp:(nullable NSNumber *)absoluteCaptureTimestampMs;
+
+@optional
+
+/**
+ * Returns the number of channels preferred by the sink. 
+ * This can be less than the numberOfChannels if down-mixing should occur.
+ * A value of -1 means an unknown number.
+ */
+- (NSInteger)preferredChannelCount;
+
+@end
+
+NS_ASSUME_NONNULL_END
