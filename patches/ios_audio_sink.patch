diff --git a/sdk/objc/api/peerconnection/RTCAudioSinkAdapter.mm b/sdk/objc/api/peerconnection/RTCAudioSinkAdapter.mm
new file mode 100644
index 0000000000..62bc5d53b8
--- /dev/null
+++ b/sdk/objc/api/peerconnection/RTCAudioSinkAdapter.mm
@@ -0,0 +1,161 @@
+/*
+ *  Copyright 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import "RTCAudioSinkAdapter+Private.h"
+
+#include <memory>
+#include <optional>
+#include "rtc_base/logging.h"
+
+// Debug flag - set to NO for release builds
+static BOOL kRTCAudioSinkDebugLogging = YES;
+
+namespace webrtc {
+
+class AudioSinkAdapter : public AudioTrackSinkInterface {
+ public:
+  AudioSinkAdapter(RTCAudioSinkAdapter* adapter) {
+    adapter_ = adapter;
+    if (kRTCAudioSinkDebugLogging) {
+      RTC_LOG(LS_VERBOSE) << "[AudioSinkAdapter] C++ AudioSinkAdapter created"
+                          << " - Address: " << this;
+    }
+  }
+  
+  ~AudioSinkAdapter() {
+    if (kRTCAudioSinkDebugLogging) {
+      RTC_LOG(LS_VERBOSE) << "[AudioSinkAdapter] C++ AudioSinkAdapter destroyed"
+                          << " - Address: " << this;
+    }
+  }
+
+  void OnData(const void* audio_data,
+              int bits_per_sample,
+              int sample_rate,
+              size_t number_of_channels,
+              size_t number_of_frames) override {
+    OnData(audio_data, bits_per_sample, sample_rate, number_of_channels,
+           number_of_frames, std::nullopt);
+  }
+
+  void OnData(const void* audio_data,
+              int bits_per_sample,
+              int sample_rate,
+              size_t number_of_channels,
+              size_t number_of_frames,
+              std::optional<int64_t> absolute_capture_timestamp_ms) override {
+    static int call_count = 0;
+    
+    if (kRTCAudioSinkDebugLogging && call_count < 5) {
+      NSLog(@"[AudioSinkAdapter DEBUG] OnData called #%d", call_count + 1);
+      NSLog(@"[AudioSinkAdapter DEBUG] - Bits per sample: %d", bits_per_sample);
+      NSLog(@"[AudioSinkAdapter DEBUG] - Sample rate: %d Hz", sample_rate);
+      NSLog(@"[AudioSinkAdapter DEBUG] - Channels: %zu", number_of_channels);
+      NSLog(@"[AudioSinkAdapter DEBUG] - Frames: %zu", number_of_frames);
+      NSLog(@"[AudioSinkAdapter DEBUG] - Data size: %zu bytes", 
+            number_of_frames * number_of_channels * (bits_per_sample / 8));
+      
+      if (absolute_capture_timestamp_ms.has_value()) {
+        NSLog(@"[AudioSinkAdapter DEBUG] - Timestamp: %lld ms", 
+              absolute_capture_timestamp_ms.value());
+      }
+      
+      RTC_LOG(LS_VERBOSE) << "[AudioSinkAdapter] OnData #" << (call_count + 1)
+                          << " - Sample rate: " << sample_rate << " Hz"
+                          << " - Channels: " << number_of_channels
+                          << " - Frames: " << number_of_frames;
+      call_count++;
+      
+      if (call_count == 5) {
+        NSLog(@"[AudioSinkAdapter DEBUG] (Stopping logs after 5 calls to avoid spam)");
+        RTC_LOG(LS_VERBOSE) << "[AudioSinkAdapter] Stopping OnData logs after 5 calls";
+      }
+    }
+    
+    NSData* audioData = [NSData dataWithBytes:audio_data
+                                       length:number_of_frames * number_of_channels * (bits_per_sample / 8)];
+    
+    NSNumber* timestampMs = nil;
+    if (absolute_capture_timestamp_ms.has_value()) {
+      timestampMs = @(absolute_capture_timestamp_ms.value());
+    }
+    
+    [adapter_.audioSink onAudioDataWithBuffer:audioData
+                                bitsPerSample:bits_per_sample
+                                   sampleRate:sample_rate
+                            numberOfChannels:number_of_channels
+                             numberOfFrames:number_of_frames
+                    absoluteCaptureTimestamp:timestampMs];
+  }
+
+  int NumPreferredChannels() const override {
+    if ([adapter_.audioSink respondsToSelector:@selector(preferredChannelCount)]) {
+      int channels = (int)[adapter_.audioSink preferredChannelCount];
+      if (kRTCAudioSinkDebugLogging) {
+        static bool logged = false;
+        if (!logged) {
+          NSLog(@"[AudioSinkAdapter DEBUG] NumPreferredChannels called, returning: %d", channels);
+          RTC_LOG(LS_VERBOSE) << "[AudioSinkAdapter] NumPreferredChannels: " << channels;
+          logged = true;
+        }
+      }
+      return channels;
+    }
+    return -1;
+  }
+
+ private:
+  __weak RTCAudioSinkAdapter* adapter_;
+};
+
+}  // namespace webrtc
+
+@implementation RTCAudioSinkAdapter {
+  std::unique_ptr<webrtc::AudioSinkAdapter> _adapter;
+}
+
+@synthesize audioSink = _audioSink;
+
+- (instancetype)initWithAudioSink:(id<RTC_OBJC_TYPE(RTCAudioSink)>)audioSink {
+  NSParameterAssert(audioSink);
+  
+  if (kRTCAudioSinkDebugLogging) {
+    NSString *sinkClassName = NSStringFromClass([audioSink class]);
+    NSLog(@"[RTCAudioSinkAdapter DEBUG] ======== ADAPTER INIT START ========");
+    NSLog(@"[RTCAudioSinkAdapter DEBUG] Creating adapter for sink: %@", sinkClassName);
+    NSLog(@"[RTCAudioSinkAdapter DEBUG] Sink address: %p", audioSink);
+  }
+  
+  self = [super init];
+  if (self) {
+    _audioSink = audioSink;
+    _adapter.reset(new webrtc::AudioSinkAdapter(self));
+    
+    if (kRTCAudioSinkDebugLogging) {
+      NSLog(@"[RTCAudioSinkAdapter DEBUG] Adapter self: %p", self);
+      NSLog(@"[RTCAudioSinkAdapter DEBUG] Native C++ adapter: %p", _adapter.get());
+      NSLog(@"[RTCAudioSinkAdapter DEBUG] ✅ Adapter successfully initialized");
+      NSLog(@"[RTCAudioSinkAdapter DEBUG] ======== ADAPTER INIT END ========");
+    }
+  }
+  return self;
+}
+
+- (void)dealloc {
+  if (kRTCAudioSinkDebugLogging) {
+    NSLog(@"[RTCAudioSinkAdapter DEBUG] Adapter being deallocated: %p", self);
+  }
+}
+
+- (webrtc::AudioTrackSinkInterface*)nativeAudioSink {
+  return _adapter.get();
+}
+
+@end
